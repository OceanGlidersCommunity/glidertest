axes.titlesize : 10
axes.labelsize : 10
date.autoformatter.day: %Y-%m-%d
date.converter: auto
figure.figsize: 8, 4
figure.dpi: 100
figure.titlesize: 10
savefig.dpi: 150
font.family:  sans-serif
