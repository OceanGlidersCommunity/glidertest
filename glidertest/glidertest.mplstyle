axes.titlesize : 25
axes.labelsize : 20
date.autoformatter.day: %Y-%m-%d
date.converter: auto
figure.figsize: 14,10
font.family:  sans-serif
font.style:   normal
font.size: 20
legend.fontsize: 15
lines.linewidth : 1
lines.linestyle: -
lines.markersize : 10
xtick.labelsize : 20
xtick.alignment: center
ytick.labelsize : 20
# constrained layout options to prevent cropping of labels etc.
figure.constrained_layout.use : True
figure.dpi     : 150
savefig.dpi    : figure
savefig.bbox   : standard  